{
  "name": "publish-to-hexium",
  "version": "0.0.0-development",
  "private": true,
  "description": "A GitHub Action that publishes package archives directly to the Hexium API.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "ncc build src/index.ts -o dist --minify --source-map",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && git diff --exit-code -- dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "fflate": "^0.8.2"
  },
  "overrides": {
    "undici": "^6.27.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.3",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@types/node": "^24.0.0",
    "@vercel/ncc": "^0.38.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.30.1",
    "prettier": "^3.6.2",
    "semantic-release": "^24.2.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^3.2.4"
  }
}
